{{ 'deferred-customisation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'deferred-customisation.js' | asset_url }}" defer="defer"></script>

<div
  class="mp-deferred-customisation"
  data-customisation-block
  data-api-url="{{ block.settings.app_url | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="mp-deferred-customisation__choices" role="radiogroup" aria-label="Customisation timing">
  <label class="mp-deferred-customisation__choice">
    <input type="radio" name="mp_customisation_choice_{{ block.id }}" value="now" checked>
    <span>Complete it now</span>
  </label>
  <label class="mp-deferred-customisation__choice">
    <input type="radio" name="mp_customisation_choice_{{ block.id }}" value="later">
    <span>Fill it in later</span>
  </label>
  </div>

  <div class="mp-deferred-customisation__now" data-complete-now>
    <label>Plushie's Name<input required type="text" maxlength="60" placeholder="NAME YOUR PLUSHIE" autocapitalize="characters" data-plush-name></label>
    <label>Plushie's Gender<select required data-gender><option>Male</option><option>Female</option></select></label>
    <label>Plushie's Birth Date<span class="mp-deferred-customisation__date"><input required readonly type="text" aria-label="Plushie's Birth Date" data-birth-date><span data-date-display>A meaningful date</span></span></label>
    <label>Plushie's Birth Place<input required type="text" maxlength="100" placeholder="A meaningful place" data-birth-place></label>
    <label>Plushie's Favourite Person<input required type="text" maxlength="100" placeholder="A meaningful person" data-favourite-person></label>
    <label>Plushie Belongs To<input required type="text" maxlength="100" placeholder="The plushie's owner" data-belongs-to></label>
    <label>Meaningful Note<textarea required maxlength="1000" placeholder="A message for the plushie's owner" data-meaningful-note></textarea></label>
    <label class="mp-deferred-customisation__voice">Upload Your Voice Here<input required type="file" accept="audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/webm,.mp3,.mp4,.m4a,.wav,.webm" data-voice><span data-voice-button>UPLOAD VOICE (MP4/MP3)</span></label>
  </div>

  <div class="mp-deferred-customisation__later" hidden>
    <label>
      Send my link by
      <select data-delivery-method>
        <option value="email">Email</option>
        <option value="whatsapp">WhatsApp</option>
      </select>
    </label>
    <label data-email-field>
      A link to customise your plushie will be sent to your email
      <input type="email" autocomplete="email" placeholder="you@example.com" data-contact-email>
    </label>
    <label data-phone-field hidden>
      A link to customise your plushie will be sent to your WhatsApp
      <input type="tel" autocomplete="tel" placeholder="012 345 6789" data-contact-phone>
      <small>We prepare the message for you; a Meaningful Plushies team member sends it manually.</small>
    </label>
  </div>
  <p class="mp-deferred-customisation__notice" aria-live="polite" data-notice></p>
</div>

{% schema %}
{
  "name": "Customise later",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "url", "id": "app_url", "label": "Fulfilment app URL", "info": "Example: https://meaningful-plushies-fulfilment.vercel.app" }
  ]
}
{% endschema %}
