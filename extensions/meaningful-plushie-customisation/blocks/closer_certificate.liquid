{% liquid
  assign certificate_id = block.settings.certificate_id | default: metaobject.system.handle | default: page.handle
  assign app_url = block.settings.app_url | default: 'https://meaningfulplushies.com/apps/closer'
%}

{{ 'closer-certificate.css' | asset_url | stylesheet_tag }}

<section class="closer-certificate" style="--closer-background: {{ block.settings.background }}; --closer-card: {{ block.settings.card_background }}; --closer-text: {{ block.settings.text_color }}; --closer-accent: {{ block.settings.accent_color }};" {{ block.shopify_attributes }}>
  <div class="closer-certificate__card">
    <p class="closer-certificate__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    <h2>{{ block.settings.heading | escape }}</h2>
    <p>{{ block.settings.description | escape }}</p>
    <a class="closer-certificate__button" href="{{ app_url }}/closer?certificate={{ certificate_id | url_encode }}&key={{ block.settings.access_key | url_encode }}">{{ block.settings.button_label | escape }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Closer certificate",
  "target": "section",
  "settings": [
    { "type": "text", "id": "certificate_id", "label": "Certificate ID", "info": "Leave blank to use the current metaobject handle." },
    { "type": "text", "id": "access_key", "label": "Certificate access key", "info": "Connect this to the private access-key field for the current certificate." },
    { "type": "url", "id": "app_url", "label": "Closer app address" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A little closer, wherever you are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your shared space" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Connect your two plushies to share photos and voice notes across the distance." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Open your space" },
    { "type": "color", "id": "background", "label": "Page background", "default": "#e7eedf" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#fffdf8" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#17302b" },
    { "type": "color", "id": "accent_color", "label": "Button and accent colour", "default": "#d76b83" }
  ]
}
{% endschema %}
