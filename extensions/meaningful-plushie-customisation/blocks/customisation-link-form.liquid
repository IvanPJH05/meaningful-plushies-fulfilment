{{ 'deferred-customisation.css' | asset_url | stylesheet_tag }}
{{ 'customisation-polish.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customisation-link-form.js' | asset_url }}" defer="defer"></script>

<div class="mp-deferred-customisation" data-customisation-link-block data-api-url="{{ block.settings.app_url | escape }}" {{ block.shopify_attributes }}>
  <form class="mp-deferred-customisation__now">
    <label>Plushie's Name<input required maxlength="20" placeholder="NAME YOUR PLUSHIE" data-plush-name></label>
    <label>Plushie's Gender<select required data-gender><option>Male</option><option>Female</option></select></label>
    <label>Plushie's Birth Date<input required maxlength="12" placeholder="A meaningful date" data-birth-date></label>
    <label>Plushie's Birth Place<input required maxlength="12" placeholder="A meaningful place" data-birth-place></label>
    <label>Plushie's Favourite Person<input required maxlength="12" placeholder="A meaningful person" data-favourite-person></label>
    <label>Plushie Belongs To<input required maxlength="12" placeholder="The plushie's owner" data-belongs-to></label>
    <label>Meaningful Note<textarea required maxlength="12" placeholder="A message for the plushie's owner" data-meaningful-note></textarea></label>
    <label class="mp-deferred-customisation__voice">Upload Your Voice Here<input required type="file" accept="audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/webm,.mp3,.mp4,.m4a,.wav,.webm" data-voice><span data-voice-button>UPLOAD VOICE (MP4/MP3)</span></label>
    <button class="mp-customisation-link-submit" type="submit">SAVE MY CUSTOMISATION</button>
    <p class="mp-deferred-customisation__notice" aria-live="polite" data-notice></p>
  </form>
</div>
{% schema %}
{"name":"Customisation link form","target":"section","enabled_on":{"templates":["page"]},"settings":[{"type":"url","id":"app_url","label":"Fulfilment app URL","info":"Example: https://meaningful-plushies-fulfilment.vercel.app"}]}
{% endschema %}
