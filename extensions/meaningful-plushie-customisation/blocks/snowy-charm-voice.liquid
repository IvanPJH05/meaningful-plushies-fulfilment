{{ 'snowy-charm-voice.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snowy-charm-voice.js' | asset_url }}" defer="defer"></script>

<section class="mp-snowy-charm-voice" data-snowy-charm-voice data-api-url="{{ block.settings.app_url | default: 'https://meaningful-plushies-fulfilment.vercel.app' | escape }}" {{ block.shopify_attributes }}>
    <div class="mp-snowy-charm-voice__choices" role="group" aria-label="Voice message source">
      <button type="button" class="is-active" data-select-record aria-pressed="true">Record voice</button>
      <button type="button" data-select-upload aria-pressed="false">Upload audio</button>
    </div>
    <div class="mp-snowy-charm-voice__panel">
      <div class="mp-snowy-charm-voice__record-control" data-record-control><button type="button" data-record>Record voice</button></div>
      <label class="mp-snowy-charm-voice__upload" data-upload-control hidden><span>Choose your audio file</span><input type="file" accept="audio/*,.mp3,.mp4,.m4a,.ogg,.oga,.wav,.webm" data-audio-file><strong>Choose audio file</strong></label>
      <div class="mp-snowy-charm-voice__preview" data-preview-wrap hidden>
        <audio data-preview preload="metadata"></audio>
        <button type="button" data-play aria-label="Play voice message"><span class="mp-snowy-charm-voice__play-icon" aria-hidden="true">▶</span><span data-play-label>Play</span><i data-loading hidden aria-hidden="true"></i></button>
        <div class="mp-snowy-charm-voice__track"><input type="range" min="0" max="0" step="0.1" value="0" data-seek aria-label="Voice message progress"><span data-time>0:00 / 0:00</span></div>
      </div>
      <p class="mp-snowy-charm-voice__file" data-file-name aria-live="polite"></p>
      <div class="mp-snowy-charm-voice__progress" data-progress hidden aria-live="polite"><div><span data-progress-label>Preparing upload…</span><strong data-progress-percent>0%</strong></div><span><i data-progress-bar></i></span></div>
      <p class="mp-snowy-charm-voice__notice" data-notice aria-live="polite"></p>
    </div>
    <div class="mp-snowy-charm-voice__dialog" data-record-dialog hidden role="dialog" aria-modal="true" aria-labelledby="mp-snowy-record-title"><div class="mp-snowy-charm-voice__dialog-card"><p>Your voice message</p><strong data-record-countdown>3</strong><h2 id="mp-snowy-record-title" data-record-status>Get ready</h2><span data-record-time>0:20 left</span><span class="mp-snowy-charm-voice__dialog-bar"><i data-record-progress></i></span><button type="button" data-record-stop hidden>Stop recording</button><button type="button" data-record-cancel>Cancel</button></div></div>
</section>

{% schema %}
{
  "name": "Plush Charm voice message",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "url", "id": "app_url", "label": "Fulfilment app URL", "info": "Example: https://meaningful-plushies-fulfilment.vercel.app" }
  ]
}
{% endschema %}
