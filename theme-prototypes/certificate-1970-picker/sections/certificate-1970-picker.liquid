{% liquid
  assign card_code = metaobject.code.value
  assign is_shared_card = false
  assign is_shared_child = false
  if card_code == '19701698520'
    assign is_shared_card = true
  elsif card_code == '19701698520-1' or card_code == '19701698520-2'
    assign is_shared_child = true
  endif
%}
{% if is_shared_card or is_shared_child %}
  <style>
    #shopify-section-{{ section.id }} .mp-card-switch { display:block; padding:16px; text-align:center; background:#f2f8fc; }
    #shopify-section-{{ section.id }} .mp-card-switch a { color:#254c63; font-weight:600; text-underline-offset:4px; }
    {% if is_shared_card %}
      #MainContent > .shopify-section:not(#shopify-section-{{ section.id }}) { display:none; }
      #shopify-section-{{ section.id }} { min-height:70vh; display:grid; place-items:center; background:#eef6fc; padding:32px 16px; }
      #shopify-section-{{ section.id }} dialog { position:fixed; inset:0; margin:auto; width:min(520px,calc(100% - 32px)); max-height:calc(100dvh - 48px); overflow:auto; border:1px solid #dce7ef; border-radius:24px; padding:32px 24px; background:#fff; color:#243b4a; text-align:center; box-shadow:0 20px 80px #12324833; z-index:100; }
      #shopify-section-{{ section.id }} dialog::backdrop { background:#17364d70; }
      #shopify-section-{{ section.id }} h1 { font-family:inherit; font-size:clamp(24px,5vw,32px); line-height:1.2; margin:8px 0 16px; }
      #shopify-section-{{ section.id }} p { line-height:1.6; margin:0 0 20px; }
      #shopify-section-{{ section.id }} .mp-card-options { display:grid; gap:12px; }
      #shopify-section-{{ section.id }} .mp-card-option { display:block; padding:20px 16px; border:1px solid #ccdfe9; border-radius:16px; color:#24475e; background:#f4f9fc; text-decoration:none; overflow-wrap:anywhere; }
      #shopify-section-{{ section.id }} .mp-card-option:hover { background:#e4f0f8; border-color:#547f99; }
      #shopify-section-{{ section.id }} .mp-card-option:focus-visible { outline:3px solid #38799e; outline-offset:3px; }
      #shopify-section-{{ section.id }} .mp-card-option strong { display:block; font-size:20px; margin-bottom:5px; }
      #shopify-section-{{ section.id }} .mp-card-option span { display:block; font-size:15px; }
      #shopify-section-{{ section.id }} .mp-card-hint { font-size:13px; color:#607889; margin:20px 0 0; }
    {% endif %}
  </style>
  <div data-mp-card-1970 data-card-code="{{ card_code | escape }}" data-mode="{% if is_shared_card %}picker{% else %}certificate{% endif %}">
    {% if is_shared_card %}
      <dialog open aria-labelledby="CardChoiceTitle-{{ section.id }}" data-card-dialog>
        <h1 id="CardChoiceTitle-{{ section.id }}">Which plushie's ID would you like to open?</h1>
        <p>Two meaningful plushies share this card link. Choose yours below.</p>
        <div class="mp-card-options">
          <a class="mp-card-option" data-card-choice="19701698520-1" href="/pages/certificate/19701698520-1"><strong>BEST YE YE</strong><span>Billy · Born 7 November 2026</span></a>
          <a class="mp-card-option" data-card-choice="19701698520-2" href="/pages/certificate/19701698520-2"><strong>SUPER PAPA</strong><span>Dragon Warrior · Born 12 November 2026</span></a>
        </div>
        <p class="mp-card-hint">We'll remember your choice in this browser. You can change it from either certificate.</p>
      </dialog>
    {% else %}
      <div class="mp-card-switch"><a href="/pages/certificate/19701698520?choose=1">Change plushie</a></div>
    {% endif %}
  </div>
  <script src="{{ 'certificate-1970-picker.js' | asset_url }}" defer></script>
{% endif %}
{% schema %}
{"name":"Card 1970 ID choice","settings":[],"presets":[{"name":"Card 1970 ID choice"}]}
{% endschema %}
