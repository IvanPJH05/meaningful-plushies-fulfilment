import { beforeEach, expect, it, vi } from "vitest";
const m=vi.hoisted(()=>({session:vi.fn(),from:vi.fn(),select:vi.fn(),eq:vi.fn(),lt:vi.fn(),order:vi.fn(),limit:vi.fn(),single:vi.fn(),insert:vi.fn(),result:{data:[] as unknown[],error:null}}));
vi.mock('../lib/mobile-api',()=>({requireMobileSession:m.session,mobileServiceClient:()=>({from:m.from})}));
import { GET,POST } from '../app/api/fulfilment/batches/history/route';
const id='00000000-0000-4000-8000-000000000001';
beforeEach(()=>{vi.resetAllMocks();m.result={data:[],error:null};m.session.mockResolvedValue({displayName:'Staff',username:'staff'});const chain={select:m.select,eq:m.eq,lt:m.lt,order:m.order,limit:m.limit,maybeSingle:m.single,insert:m.insert,then:(resolve:Function)=>Promise.resolve(m.result).then(resolve as never)};for(const fn of [m.from,m.select,m.eq,m.lt,m.order,m.limit])fn.mockReturnValue(chain);m.single.mockResolvedValue({data:{id,number:1,stage:'printing'},error:null});m.insert.mockResolvedValue({error:null});});
it('requires a warehouse session before accessing history',async()=>{m.session.mockRejectedValue(new Error('SIGN_IN_REQUIRED'));expect((await GET(new Request('https://app.test/history'))).status).toBe(401);expect(m.from).not.toHaveBeenCalled();});
it('paginates batch summaries without loading orders or actions',async()=>{await GET(new Request('https://app.test/history?before=50'));expect(m.from).toHaveBeenCalledTimes(1);expect(m.from).toHaveBeenCalledWith('fulfilment_batches');expect(m.limit).toHaveBeenCalledWith(51);expect(m.lt).toHaveBeenCalledWith('number','50');});
it('paginates actions only for the selected batch',async()=>{m.result.data=Array.from({length:101},(_,i)=>({id:200-i,action:'nfc'}));const response=await GET(new Request(`https://app.test/history?id=${id}&before=300`));const data=await response.json();expect(data.events).toHaveLength(100);expect(data.more).toBe(true);expect(m.eq).toHaveBeenCalledWith('batch_id',id);expect(m.lt).toHaveBeenCalledWith('id','300');expect(m.limit).toHaveBeenCalledWith(101);});
it('rejects invalid selectors before database reads',async()=>{expect((await GET(new Request('https://app.test/history?id=invalid'))).status).toBe(400);expect(m.from).not.toHaveBeenCalled();});
it('records staff identity on allowed file actions',async()=>{const response=await POST(new Request('https://app.test/history',{method:'POST',body:JSON.stringify({batchId:id,action:'packing_slips_generated'})}));expect(response.status).toBe(200);expect(m.insert).toHaveBeenCalledWith({batch_id:id,action:'packing_slips_generated',actor:'Staff (staff)'});});
it('rejects a file action at the wrong batch stage',async()=>{const response=await POST(new Request('https://app.test/history',{method:'POST',body:JSON.stringify({batchId:id,action:'audio_zip_download_started'})}));expect(response.status).toBe(400);expect(m.insert).not.toHaveBeenCalled();});
