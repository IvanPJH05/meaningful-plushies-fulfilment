import { beforeEach,it,expect,vi } from "vitest";
const mocks=vi.hoisted(()=>({rows:[] as any[],writes:[] as any[],failBind:false,certificate:vi.fn(),metafield:vi.fn()}));
vi.mock("@supabase/supabase-js",()=>({createClient:()=>({from:()=>{
 let mutation:any=null, filter="";
 const query:any={select:()=>query,in:()=>query,or:()=>query,eq:(key:string,value:string)=>{if(key==="id")filter=value;return query;},update:(payload:any)=>{mutation=payload;return query;},then:(ok:any,fail:any)=>Promise.resolve(mutation?(mocks.writes.push({id:filter,...mutation}),{data:mocks.failBind?[]:[{id:filter}],error:null}):{data:mocks.rows,error:null}).then(ok,fail)};return query;
}})}));
vi.mock("../lib/shopify-orders",()=>({certificateMediaForLineItem:()=>({}),certificateMetaobjectForOrder:async()=>null,createCertificateMetaobject:vi.fn(),plushBackgroundForMeaningfulNote:()=>"",setShopifyOrderMetafield:mocks.metafield,shopDomain:()=>"test.myshopify.com",shopifyGraphql:vi.fn(),updateCertificateMetaobject:mocks.certificate}));
import {bindSessionsToOrders} from "../lib/customisation";
const a="00000000-0000-4000-8000-000000000001",b="00000000-0000-4000-8000-000000000002";
function session(id:string,name:string){return {id,status:"submitted",order_id:null,order_number:null,fulfilment_order_id:null,form_data:{plushName:name,gender:"Female",birthDate:"01/01/2020",birthPlace:"Home",favouritePerson:"Person",belongsTo:"Owner",meaningfulNote:"Note"},voice_storage_path:`${id}/voice.mp3`,completed_at:"2026-10-22T15:00:00Z",delivery_method:null};}
function order(id:string,sessionId?:string){return {id,customisationSessionId:sessionId,shopifyLineItemId:`line-${id}`,character:"Billy",product:"Billy 10s",voiceLength:10,status:"awaiting_customisation",statusHistory:[],certificateCode:"cert",idWebsiteLink:"existing"} as any;}
beforeEach(()=>{vi.clearAllMocks();mocks.rows=[];mocks.writes=[];mocks.failBind=false;mocks.certificate.mockResolvedValue(true);mocks.metafield.mockResolvedValue(true);vi.stubEnv("SUPABASE_SERVICE_ROLE_KEY","fixture-only");vi.stubEnv("GOOGLE_DRIVE_CLIENT_ID","");});
it("two saved submissions never override the exact session carried by the purchased line",async()=>{mocks.rows=[session(a,"OLDER"),session(b,"LATEST")];const result=await bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a,b],orders:[order("one",b)],certificates:[{id:"meta",code:"cert"}]});expect(result[0].plushName).toBe("LATEST");expect(result[0].meaningfulMessage).toBe(`supabase-storage:${b}/voice.mp3`);expect(mocks.writes.map(x=>x.id)).toEqual([b]);expect(mocks.certificate).toHaveBeenCalledOnce();});
it("multiple purchased lines keep their own sessions regardless of query order",async()=>{mocks.rows=[session(b,"SECOND"),session(a,"FIRST")];const result=await bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[b,a],orders:[order("one",a),order("two",b)],certificates:[{id:"m1",code:"c1"},{id:"m2",code:"c2"}]});expect(result.map(x=>x.plushName)).toEqual(["FIRST","SECOND"]);expect(result.map(x=>x.certificateCode)).toEqual(["c1","c2"]);});
it("a stale cart mirror is ignored when the line has its exact reference",async()=>{mocks.rows=[session(a,"PURCHASED"),session(b,"STALE")];const result=await bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[b,a],orders:[order("one",a)],certificates:[{id:"m",code:"c"}]});expect(result[0].plushName).toBe("PURCHASED");expect(mocks.writes.map(x=>x.id)).toEqual([a]);});
it("never guesses between two sessions when the order has no exact reference",async()=>{mocks.rows=[session(a,"FIRST"),session(b,"SECOND")];const original=order("one");const result=await bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a,b],orders:[original]});expect(result).toEqual([original]);expect(mocks.writes).toEqual([]);expect(mocks.certificate).not.toHaveBeenCalled();});
it("rejects assigning one session to two purchased lines",async()=>{mocks.rows=[session(a,"FIRST")];await expect(bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a],orders:[order("one",a),order("two",a)]})).rejects.toThrow("multiple fulfilment rows");expect(mocks.writes).toEqual([]);});
it("rejects a session already owned by a different order",async()=>{mocks.rows=[{...session(a,"FIRST"),order_id:"other-order"}];await expect(bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a],orders:[order("one",a)]})).rejects.toThrow("different order");expect(mocks.writes).toEqual([]);});
it("retains an advanced production status when a webhook replays",async()=>{mocks.rows=[{...session(a,"FIRST"),order_id:"shopify-1",fulfilment_order_id:"one"}];const original={...order("one",a),status:"sent_for_sewing"};const result=await bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a],orders:[original],certificates:[{id:"m",code:"c"}]});expect(result[0].status).toBe("sent_for_sewing");expect(result[0].statusHistory).toEqual([]);});
it("charms retain their Our Link and never receive a birth certificate",async()=>{mocks.rows=[{...session(a,""),form_data:{productType:"plush_charm"}}];const original={...order("one",a),productType:"plush_charm",idWebsiteLink:"https://example.test/our-link",certificateCode:""};const result=await bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a],orders:[original],certificates:[null]});expect(result[0].idWebsiteLink).toBe(original.idWebsiteLink);expect(result[0].certificateCode).toBe("");expect(result[0].voiceUploadStatus).toBe("received");expect(mocks.certificate).not.toHaveBeenCalled();});
it("a competing binding causes a retry instead of falsely reporting success",async()=>{mocks.rows=[session(a,"FIRST")];mocks.failBind=true;await expect(bindSessionsToOrders({orderId:"shopify-1",orderNumber:"1937",sessionIds:[a],orders:[order("one",a)],certificates:[{id:"m",code:"c"}]})).rejects.toThrow("concurrently");expect(mocks.certificate).not.toHaveBeenCalled();});
