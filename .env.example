DATABASE_URL=
DIRECT_URL=
REDIS_URL=redis://localhost:6379
CRM_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
CRM_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
CRM_SEED_ADMIN_EMAIL=
CRM_SEED_ADMIN_PASSWORD=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
