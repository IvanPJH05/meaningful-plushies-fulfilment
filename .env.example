NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only. Used only by the deferred customisation API; never prefix either
# value with NEXT_PUBLIC_. Generate a new 32-byte random key for encryption.
SUPABASE_SERVICE_ROLE_KEY=
CUSTOMISATION_TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=https://meaningful-plushies-fulfilment.vercel.app
CUSTOMISATION_STOREFRONT_URL=https://meaningfulplushies.com/pages/birth-certificate-customization?view=customise-your-plushie
# Optional automatic email delivery for customers who choose Email.
RESEND_API_KEY=
CUSTOMISATION_EMAIL_FROM=
# Google Drive archive (server-only). Create a Google OAuth web client, connect
# the owner's Google account once, and set the destination folder ID.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
CANVA_CLIENT_ID=YOUR_CANVA_CONNECT_CLIENT_ID
CANVA_CLIENT_SECRET=YOUR_CANVA_CONNECT_CLIENT_SECRET
CANVA_REDIRECT_URI=https://YOUR_DOMAIN.vercel.app/api/canva/callback
CANVA_ENVELOPE_TEMPLATE_ID=EAHMnYdOAJk
SHOPIFY_WEBHOOK_SECRET=YOUR_SHOPIFY_APP_CLIENT_SECRET
SHOPIFY_CLIENT_ID=YOUR_SHOPIFY_APP_CLIENT_ID
SHOPIFY_CLIENT_SECRET=YOUR_SHOPIFY_APP_CLIENT_SECRET
# Optional legacy/custom-app fallback. New Dev Dashboard apps can leave this blank.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-04
SHOPIFY_UPLOAD_LIFT_METAFIELD_KEY=upload_lift_form_data
SHOPIFY_UPLOAD_LIFT_METAFIELD_NAMESPACE=custom
SHOPIFY_TIKTOK_CERT_METAOBJECT_TYPE=$app:tik_tok_shop_cert_input
SHOPIFY_TIKTOK_CERT_UPLOAD_DATE_FIELD=upload_date
SHOPIFY_TIKTOK_CERT_INPUT_FIELD=input
# Meaningful Fulfilment creates and updates the certificate itself. Set false
# only while a legacy Shopify Flow still creates the same certificate entry.
CERTIFICATE_AUTOMATION_ENABLED=true
SHOPIFY_CERTIFICATE_METAOBJECT_TYPE=version_1_certs
NEXT_PUBLIC_SHOPIFY_STOREFRONT_URL=https://meaningfulplushies.com
NEXT_PUBLIC_INFLUENCER_ORDER_PAGE_PATH=/products/build-your-meaningful-plushie
# Manual Orders: JSON array of products/variants that can receive the 100% manual-order discount.
# Shopify product/variant IDs are optional when productPath points to a live Shopify product handle.
# If public product lookup fails, provide IDs here.
# Example:
# MANUAL_ORDER_PRODUCTS_JSON=[{"key":"plushie_20s","displayName":"Meaningful Plushie - 20 seconds","productPath":"products/meaningful-plushie","shopifyProductId":"1234567890","shopifyVariantId":"9876543210"}]
MANUAL_ORDER_PRODUCTS_JSON=
NEXT_PUBLIC_MANUAL_ORDER_PRODUCTS_JSON=
NEXT_PUBLIC_SHOPIFY_ADMIN_STORE_HANDLE=
# Optional fallback. You can save the Pixel ID in Settings > Meta CAPI instead.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=YOUR_META_CONVERSIONS_API_ACCESS_TOKEN
META_TEST_EVENT_CODE=
META_AD_ACCOUNT_ID=act_YOUR_META_AD_ACCOUNT_ID
META_ADS_ACCESS_TOKEN=YOUR_META_MARKETING_API_ACCESS_TOKEN
META_GRAPH_API_VERSION=v20.0
TIKTOK_SHOP_APP_KEY=YOUR_TIKTOK_SHOP_APP_KEY
TIKTOK_SHOP_APP_SECRET=YOUR_TIKTOK_SHOP_APP_SECRET
TIKTOK_SHOP_ACCESS_TOKEN=YOUR_TIKTOK_SHOP_ACCESS_TOKEN
TIKTOK_SHOP_ID=YOUR_TIKTOK_SHOP_ID
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_ORDER_DETAIL_PATH=/api/orders/detail/query
TIKTOK_WEBHOOK_SECRET=

